# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-openssl-rand-hex-32
PUBLIC_URL=http://omarchy-server.local:5199
APP_URL=http://omarchy-server.local:5199
# Optional: enables POST /api/users/password (legacy first-password bootstrap)
ADMIN_TOKEN=
# Optional: extra CORS origins, comma separated (same-origin needs none)
CORS_ORIGINS=
# Filesystem import allowlist (colon or comma separated). Mount host dirs here.
IMPORT_ROOTS=/data/imports
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
